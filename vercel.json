{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/oauth/consent",
      "destination": "/react.html"
    },
    {
      "source": "/integrations",
      "destination": "/react.html"
    },
    {
      "source": "/login",
      "destination": "/react.html"
    }
  ]
}
