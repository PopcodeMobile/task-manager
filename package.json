{
  "name": "gr8r-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Gr8r Studio: a calm, structured project management workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run check:tokens && npm run build",
    "typecheck": "tsc --noEmit",
    "test:oauth:ui": "playwright test --config playwright.oauth.config.ts",
    "local:oauth:key": "node scripts/setup-local-oauth.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide": "^0.460.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/middleware": "1.0.0",
    "@supabase/server": "1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "^3.4.17",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "3.7.0",
    "zod": "4.3.6"
  }
}
