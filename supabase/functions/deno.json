{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  },
  "lock": "./deno.lock",
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "test": "deno test --allow-env --allow-net tests/",
    "check": "deno check api/index.ts tests/*.test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  }
}
