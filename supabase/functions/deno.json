{
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "lock": "./deno.lock",
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "test": "deno test --unstable-no-legacy-abort --allow-env --allow-net tests/",
    "check": "deno check api/index.ts mcp/index.ts webhook-dispatch/index.ts tests/*.test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.3.1",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@2.3.1",
    "@supabase/server": "npm:@supabase/server@1.9.2",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "zod": "npm:zod@4.3.6",
    "jose": "npm:jose@6.2.12"
  }
}
